[Unit]
Description=SafeCare Provisioning Captive Portal
ConditionPathExists=!/opt/safecare/.provisioned
# Order: start after the AP, but use Wants= (not Requires=) so that when
# the provisioner deliberately stops safecare-ap to hand wlan0 over to
# nmcli, systemd doesn't cascade-stop the provisioner itself and kill
# the in-flight worker thread mid-connect.
After=safecare-ap.service
Wants=safecare-ap.service

[Service]
Type=simple
WorkingDirectory=/opt/safecare/scripts/rpi
ExecStart=/usr/bin/python3 provisioner.py
Restart=on-failure
RestartSec=2
Environment=SAFECARE_ROOT=/opt/safecare

[Install]
WantedBy=safecare-firstboot.service
